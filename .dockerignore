# 构建上下文裁剪：把镜像里用不到的东西挡在外面，加速构建、缩小镜像。
.git
.github
.gitignore
*.md
LICENSE

# Runtime skill contracts are consumed by SkillResolver inside the image.
# Re-include this subtree after the broad markdown exclusion above.
!framework/
!framework/06_global_rules.md
!framework/skills/
!framework/skills/*.md

# Python 缓存与本地产物
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# 虚拟环境
.venv/
.wheel-smoke/
.ci-wheel-venv/
.ci-wheel-venv-final*/
venv/

# 本地 SQLite 库与环境文件（密钥不进镜像）
*.db
.env*
!.env.example

# 测试与评估不进运行镜像
tests/
eval/

# 前端依赖与本地构建产物（镜像内由 node 阶段重新构建）
frontend/node_modules/
frontend/.vite/
frontend/dist/
node_modules/

# Local virtual environments and build artefacts
.venv-desktop/
.venv-*/
build/
dist/
backups/
*.egg-info/
.coverage
coverage.xml

# Local runtime state and database sidecar files
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
data/
runtime_config.json

# Local assets and temporary audit output
*.png
*.jpg
*.jpeg
*.gif
*.webp
!frontend/public/research-field.png
.tmp-*/
