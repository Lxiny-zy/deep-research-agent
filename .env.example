# 复制为 .env 并填写。Docker Compose 会自动读取；直接运行 CLI/API 时请使用
# README 中显式加载 .env 的命令（或先 export 到环境变量）。

# --- LLM：任意 OpenAI 兼容端点 ---
LLM_API_KEY=
# 默认 OpenAI 官方；用 DeepSeek/Qwen/GLM/Moonshot 时改这里
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# 上游网关（Cloudflare Bot Fight Mode 等）按 UA 拦截 openai SDK 默认的
# "OpenAI/Python ..." 时改这里；默认已伪装成浏览器 UA，通常无需设置
# LLM_USER_AGENT=

# --- 检索：https://tavily.com 注册可得免费额度 ---
TAVILY_API_KEY=

# 启用的检索后端（逗号分隔，默认仅 tavily）。多后端会并发查询并按归一化 URL 去重，
# 提高交叉印证门禁可判定的「独立发布方」召回上限。
# 可选：tavily、brave（通用网页索引）、openalex、arxiv（学术源）
# DR_SEARCH_BACKENDS=tavily,brave
# BRAVE_API_KEY=

# --- 学术检索源：无需 API Key ---
# openalex / arxiv 额外提供 DOI、作者机构、期刊、撤稿标记与开放全文位置——
# 这些字段通用网页检索拿不到，而科学场景的引用与独立性判定依赖它们。
# 例：DR_SEARCH_BACKENDS=openalex,arxiv
#
# 注意 OpenAlex 有「每日免费配额」（约 1000 次/日，按出口 IP 计，UTC 午夜重置）。
# 一次研究只消耗个位数请求，正常用量远够；但共享出口 IP（NAT / 云主机）可能被
# 同 IP 的其他调用提前耗尽，此时该后端会抛出带重置时间的配额错误。
# 多后端配置下这个失败是被隔离的：其余后端照常产出，只留一条审计事件。
#
# OpenAlex 礼貌池联系邮箱。不是密钥，留空也能用，配置后调度更稳定。
# OPENALEX_MAILTO=you@example.org

# --- 执行拓扑：inline（默认，API 自己执行）/ worker（API 只入队，独立进程执行）---
# DR_EXECUTION_MODE=inline
# DR_WORKER_POLL_SECONDS=1.0
# DR_MAX_CLAIM_ATTEMPTS=3

# --- Planner/artifact/operation runner (shared by api and optional worker) ---
# planner-driven is the default: every run gets the durable plan/artifact
# contract and the shared global orchestration rules.  Set legacy only for
# compatibility with an older deployment; hybrid enables staged migration.
# DR_ORCHESTRATION_MODE=planner-driven
# Docker uses a named volume mounted at /app/artifacts.  For local execution,
# a relative path such as ./artifacts is also supported.
# DR_ARTIFACT_ROOT=/app/artifacts
# DR_ARTIFACT_MAX_BYTES=104857600
# The runner executes registered operation IDs only; it never executes raw
# shell text from a planner response. The base Docker image contains the
# registry contract, but not bsdtar/libreoffice/latexmk; install those tools
# in a dedicated worker image before enabling the corresponding IDs.
# DR_RUNNER_ENABLED=true
# DR_RUNNER_DEFAULT_TIMEOUT=300
# DR_RUNNER_MAX_OUTPUT_BYTES=256000
# DR_RUNNER_MAX_PROCESSES=2
# DR_RUNNER_ALLOWED_OPERATIONS=archive.unpack,pdf.convert,latex.compile

# --- API 认证（强烈建议生产配置）：设置后所有 /api 端点要求
# Authorization: Bearer 或 X-API-Key 请求头；留空则不启用（仅限本地开发）---
# API_KEY=
# APP_ENV=development
# 生产环境必填 Fernet key；生成命令：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CATALOG_ENCRYPTION_KEY=
# 可选：逗号分隔的上游模型主机白名单，支持 *.example.com
# PROVIDER_HOST_ALLOWLIST=api.openai.com
# 默认拒绝 HTTP、localhost、私网/保留地址；仅本地受控开发可显式放开
# ALLOW_PRIVATE_PROVIDER_URLS=false
# Docker 默认只监听服务器本机，由 Nginx/Caddy 反代；确需直接暴露时设为 0.0.0.0
# APP_BIND=127.0.0.1
# 仅在 API 只能被可信反向代理访问且代理覆盖 X-Real-IP 时启用
# APP_TRUST_PROXY=false
# Uvicorn 对 X-Forwarded-* 的信任列表。宿主机 Nginx 经 Docker bridge 访问且
# APP_BIND 保持 127.0.0.1 时可设为 *；直接暴露 API 时不要使用 *。
# FORWARDED_ALLOW_IPS=127.0.0.1

# --- 持久化：缺省本地 SQLite，零配置即可跑；切 PostgreSQL 改这里 ---
# 本地默认（不填即用此值）：sqlite+aiosqlite:///./deep_research.db
# 生产 / docker compose：postgresql+asyncpg://dr:${POSTGRES_PASSWORD}@db:5432/deep_research
# DATABASE_URL=postgresql+asyncpg://dr:CHANGE_ME@localhost:5432/deep_research

# --- docker compose 的 PostgreSQL 口令（compose 启动必填）---
# POSTGRES_PASSWORD=

# Docker 中已自动设为 /app/data/runtime_config.json 并挂载持久化卷；
# 非 Docker 部署可按需自定义：
# RUNTIME_CONFIG_PATH=./runtime_config.json

# --- 研究行为（可选；留空用内置默认。Web API 亦可按次覆盖）---
# MAX_SUB_QUESTIONS=5
# MAX_ROUNDS=2
# MAX_CONCURRENCY=4
# RESULTS_PER_SEARCH=5
# FULLTEXT_ENABLED=true
# FULLTEXT_MAX_CHARS=12000
# MAX_TOKENS=100000
# MAX_REPLANS=1
# REQUIRE_CORROBORATION=false
# REQUEST_TIMEOUT=60
# MAX_RUN_SECONDS=3600
# MAX_ACTIVE_RUNS=8
# MAX_QUEUED_RUNS=32

# --- 意图识别（可选）---
# 总开关：关闭后 IntentRouter 直接放行，不判定、不路由、不拦截（用于排查误伤 / A-B 对照）
# INTENT_ENABLED=true
# 是否允许级联升级到 L3 大模型兜底；关闭则只跑规则 + 本地模型，零 token 零网络
# INTENT_LLM_FALLBACK=true
# 来源侧意图审查：对通过 SourcePolicy 的来源再判一次意图，命中则追加隔离（只收紧不放宽）
# INTENT_SOURCE_SCREENING=true
